<configuration>
  <system.webServer>
    <handlers>
      <add name="FlaskFastCGI"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\Users\vince\OneDrive\Desktop\Nyati_flask\.venv\Scripts\python.exe|C:\Users\vince\OneDrive\Desktop\Nyati_flask\.venv\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>
  </system.webServer>
  <appSettings>
    <add key="WSGI_HANDLER" value="app.app" />
    <add key="PYTHONPATH" value="C:\Users\vince\OneDrive\Desktop\Nyati_flask" />
    <add key="WSGI_LOG" value="C:\Users\vince\OneDrive\Desktop\Nyati_flask\wfastcgi.log" />
  </appSettings>
</configuration>