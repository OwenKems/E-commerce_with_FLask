<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\Users\vince\OneDrive\Desktop\NYATI FLASK\env\Scripts\python.exe|C:\Users\vince\OneDrive\Desktop\NYATI FLASK\env\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified"
           requireAccess="Script"/>
    </handlers>
  </system.webServer>
  <appSettings>
    <add key="WSGI_HANDLER" value="app.app"/>
    <add key="PYTHONPATH" value="C:\Users\vince\OneDrive\Desktop\NYATI FLASK"/>
    <add key="WSGI_LOG" value="C:\Users\vince\OneDrive\Desktop\NYATI FLASK\wfastcgi.log"/>
  </appSettings>
</configuration>
